{% liquid
  assign hero_link = section.settings.hero_button_link
  if hero_link == blank
    assign hero_link = routes.all_products_collection_url
  endif

  assign hero_button_label = section.settings.hero_button_label
  if hero_button_label == blank
    assign hero_button_label = 'Shop now'
  endif
%}

<section
  class="luxe-homepage full-width"
  style="
    --luxe-bg: {{ section.settings.background_color }};
    --luxe-surface: {{ section.settings.surface_color }};
    --luxe-text: {{ section.settings.text_color }};
    --luxe-muted: {{ section.settings.muted_text_color }};
    --luxe-button-bg: {{ section.settings.button_background_color }};
    --luxe-button-text: {{ section.settings.button_text_color }};
  "
>
  <div class="luxe-homepage__background">
    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2200
        | image_tag:
          class: 'luxe-homepage__background-image',
          loading: 'lazy',
          sizes: '100vw',
          widths: '1200, 1600, 1800, 2200',
          alt: section.settings.background_image.alt
      }}
    {% endif %}
    <div class="luxe-homepage__background-overlay"></div>
  </div>

  <div class="luxe-homepage__container">
    <div class="luxe-homepage__hero">
      <div class="luxe-homepage__hero-copy">
        <h1 class="luxe-homepage__hero-title">{{ section.settings.hero_title | newline_to_br }}</h1>

        {% if section.settings.hero_subtitle != blank %}
          <p class="luxe-homepage__hero-subtitle">{{ section.settings.hero_subtitle }}</p>
        {% endif %}

        <a class="luxe-homepage__hero-button" href="{{ hero_link }}">{{ hero_button_label }}</a>
      </div>

      <div class="luxe-homepage__hero-media">
        {% if section.settings.hero_image != blank %}
          {{
            section.settings.hero_image
            | image_url: width: 1300
            | image_tag:
              class: 'luxe-homepage__hero-image',
              loading: 'lazy',
              sizes: '(min-width: 990px) 40vw, 85vw',
              widths: '550, 750, 950, 1150, 1300',
              alt: section.settings.hero_image.alt
          }}
        {% else %}
          <div class="luxe-homepage__hero-placeholder">
            {{ 'image' | placeholder_svg_tag: 'luxe-homepage__hero-placeholder-svg' }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="luxe-homepage__benefits" role="list">
      <div class="luxe-homepage__benefit" role="listitem">
        <span class="luxe-homepage__benefit-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path
              d="M2 12h3l2.5-4 3.5 8 3-6H22"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <span>{{ section.settings.benefit_text_1 }}</span>
      </div>

      <div class="luxe-homepage__benefit" role="listitem">
        <span class="luxe-homepage__benefit-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.4" />
            <path d="m8 12.5 2.5 2.5L16 9.5" fill="none" stroke="currentColor" stroke-width="1.4" />
          </svg>
        </span>
        <span>{{ section.settings.benefit_text_2 }}</span>
      </div>

      <div class="luxe-homepage__benefit" role="listitem">
        <span class="luxe-homepage__benefit-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path
              d="M4 8h16l-1 10H5L4 8Zm2-2h12l1 2H5l1-2Zm4 6v4m4-4v4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <span>{{ section.settings.benefit_text_3 }}</span>
      </div>
    </div>

    <section class="luxe-homepage__catalog">
      <h2 class="luxe-homepage__section-title">{{ section.settings.best_sellers_heading }}</h2>

      <div class="luxe-homepage__catalog-grid">
        {% assign product_blocks = section.blocks | where: 'type', 'product_card' %}
        {% if product_blocks.size > 0 %}
          {% for block in product_blocks %}
            {% liquid
              assign product_ref = block.settings.product
              assign card_link = block.settings.link
              assign card_title = block.settings.title
              assign card_price = block.settings.price_text
              assign card_compare_price = block.settings.compare_price_text

              if product_ref != blank
                assign card_link = product_ref.url
                assign card_title = product_ref.title
                assign card_price = product_ref.price | money
                if product_ref.compare_at_price_max > product_ref.price
                  assign card_compare_price = product_ref.compare_at_price_max | money
                else
                  assign card_compare_price = blank
                endif
              endif

              if card_link == blank
                assign card_link = routes.all_products_collection_url
              endif
            %}

            <article class="luxe-product-card" {{ block.shopify_attributes }}>
              {% if block.settings.show_badge %}
                <span class="luxe-product-card__badge">{{ block.settings.badge_text }}</span>
              {% endif %}

              <a class="luxe-product-card__image-wrap" href="{{ card_link }}">
                {% if product_ref != blank and product_ref.featured_image != blank %}
                  {{
                    product_ref.featured_image
                    | image_url: width: 700
                    | image_tag:
                      class: 'luxe-product-card__image',
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 18vw, 44vw',
                      widths: '260, 350, 500, 700',
                      alt: card_title
                  }}
                {% elsif block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 700
                    | image_tag:
                      class: 'luxe-product-card__image',
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 18vw, 44vw',
                      widths: '260, 350, 500, 700',
                      alt: card_title
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'luxe-product-card__placeholder' }}
                {% endif %}
              </a>

              <div class="luxe-product-card__content">
                <h3 class="luxe-product-card__title">
                  <a href="{{ card_link }}">{{ card_title }}</a>
                </h3>

                <p class="luxe-product-card__prices">
                  <span>{{ card_price }}</span>
                  {% if card_compare_price != blank %}
                    <s>{{ card_compare_price }}</s>
                  {% endif %}
                </p>

                <a class="luxe-product-card__button" href="{{ card_link }}">{{ block.settings.button_label }}</a>
              </div>
            </article>
          {% endfor %}
        {% else %}
          {% for item in (1..4) %}
            <article class="luxe-product-card">
              <span class="luxe-product-card__badge">NEW</span>
              <a class="luxe-product-card__image-wrap" href="{{ routes.all_products_collection_url }}">
                {{ 'product-1' | placeholder_svg_tag: 'luxe-product-card__placeholder' }}
              </a>
              <div class="luxe-product-card__content">
                <h3 class="luxe-product-card__title">
                  <a href="{{ routes.all_products_collection_url }}">Signature Bundle {{ item }}</a>
                </h3>
                <p class="luxe-product-card__prices"><span>$330.00</span><s>$390.00</s></p>
                <a class="luxe-product-card__button" href="{{ routes.all_products_collection_url }}">SHOP NOW</a>
              </div>
            </article>
          {% endfor %}
        {% endif %}
      </div>
    </section>

    <section class="luxe-homepage__textures">
      <h2 class="luxe-homepage__section-title">{{ section.settings.textures_heading }}</h2>
      <div class="luxe-homepage__textures-grid">
        {% assign texture_blocks = section.blocks | where: 'type', 'texture' %}
        {% if texture_blocks.size > 0 %}
          {% for block in texture_blocks %}
            {% liquid
              assign texture_link = block.settings.link
              if texture_link == blank
                assign texture_link = routes.all_products_collection_url
              endif
            %}

            <a class="luxe-texture-card" href="{{ texture_link }}" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    class: 'luxe-texture-card__image',
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 28vw, 86vw',
                    widths: '320, 540, 700, 900',
                    alt: block.settings.label
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'luxe-texture-card__placeholder' }}
              {% endif %}
              <span class="luxe-texture-card__label">{{ block.settings.label }}</span>
            </a>
          {% endfor %}
        {% else %}
          {% assign texture_names = 'Body Wave,Curly,Straight' | split: ',' %}
          {% for texture_name in texture_names %}
            <a class="luxe-texture-card" href="{{ routes.all_products_collection_url }}">
              {{ 'image' | placeholder_svg_tag: 'luxe-texture-card__placeholder' }}
              <span class="luxe-texture-card__label">{{ texture_name }}</span>
            </a>
          {% endfor %}
        {% endif %}
      </div>
    </section>

    <section class="luxe-homepage__social-proof">
      <p class="luxe-homepage__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
      <p class="luxe-homepage__review-line">{{ section.settings.reviews_heading }}</p>
      <p class="luxe-homepage__guarantee-line">{{ section.settings.guarantee_text }}</p>
    </section>
  </div>
</section>

{% stylesheet %}
  .luxe-homepage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--luxe-bg);
    color: var(--luxe-text);
    border-bottom: 1px solid color-mix(in srgb, var(--luxe-muted) 35%, transparent);
  }

  .luxe-homepage__background {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -2;
  }

  .luxe-homepage__background-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.22;
  }

  .luxe-homepage__background-overlay {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 50% 15%, color-mix(in srgb, var(--luxe-muted) 20%, transparent), transparent 48%),
      radial-gradient(circle at 50% 88%, color-mix(in srgb, var(--luxe-muted) 10%, transparent), transparent 40%),
      linear-gradient(180deg, rgb(6 6 7 / 84%), rgb(5 5 5 / 95%));
  }

  .luxe-homepage__container {
    position: relative;
    z-index: 1;
    width: min(1200px, calc(100% - 2rem));
    margin-inline: auto;
    padding: 1rem 0 2.6rem;
  }

  .luxe-homepage__hero {
    display: grid;
    grid-template-columns: 1.1fr minmax(320px, 0.9fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: end;
    padding-top: clamp(0.5rem, 2vw, 2rem);
    border-bottom: 1px solid color-mix(in srgb, var(--luxe-muted) 35%, transparent);
  }

  .luxe-homepage__hero-copy {
    padding-bottom: 1.8rem;
  }

  .luxe-homepage__hero-title {
    font-family: 'Times New Roman', serif;
    font-size: clamp(2rem, 4.8vw, 4.8rem);
    line-height: 0.92;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-wrap: balance;
    max-width: 10ch;
  }

  .luxe-homepage__hero-subtitle {
    margin-top: 1.1rem;
    font-size: clamp(0.9rem, 1.8vw, 1.35rem);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--luxe-muted);
  }

  .luxe-homepage__hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.6rem;
    padding: 0.8rem 1.7rem;
    font-size: 0.86rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 700;
    color: var(--luxe-button-text);
    background-color: var(--luxe-button-bg);
    border-radius: 0.18rem;
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .luxe-homepage__hero-button:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }

  .luxe-homepage__hero-media {
    display: flex;
    align-items: end;
    justify-content: center;
    min-height: clamp(300px, 48vw, 680px);
  }

  .luxe-homepage__hero-image,
  .luxe-homepage__hero-placeholder {
    width: 100%;
    height: 100%;
  }

  .luxe-homepage__hero-image {
    object-fit: cover;
    object-position: center top;
    border-radius: 0.5rem 0.5rem 0 0;
  }

  .luxe-homepage__hero-placeholder {
    background: color-mix(in srgb, var(--luxe-surface) 86%, black);
    border-radius: 0.5rem 0.5rem 0 0;
    overflow: hidden;
  }

  .luxe-homepage__hero-placeholder-svg {
    height: 100%;
    width: 100%;
  }

  .luxe-homepage__hero-placeholder-svg path {
    fill: color-mix(in srgb, var(--luxe-muted) 30%, transparent);
  }

  .luxe-homepage__benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: center;
    margin-top: 1rem;
    padding: 0.9rem 0.2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--luxe-muted) 35%, transparent);
  }

  .luxe-homepage__benefit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--luxe-text) 80%, var(--luxe-muted));
    text-align: center;
  }

  .luxe-homepage__benefit-icon {
    display: inline-flex;
    width: 1.2rem;
    height: 1.2rem;
    color: var(--luxe-muted);
  }

  .luxe-homepage__benefit-icon svg {
    width: 100%;
    height: 100%;
  }

  .luxe-homepage__catalog,
  .luxe-homepage__textures {
    margin-top: 2.3rem;
  }

  .luxe-homepage__section-title {
    margin-bottom: 1rem;
    text-align: center;
    font-family: 'Times New Roman', serif;
    font-size: clamp(1.3rem, 3.2vw, 2.5rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--luxe-text);
  }

  .luxe-homepage__catalog-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .luxe-product-card {
    position: relative;
    background: color-mix(in srgb, white 95%, var(--luxe-muted) 5%);
    color: #121212;
    border: 1px solid color-mix(in srgb, var(--luxe-muted) 20%, transparent);
    overflow: hidden;
  }

  .luxe-product-card__badge {
    position: absolute;
    top: 0.45rem;
    left: 0.45rem;
    z-index: 2;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    font-weight: 700;
    text-transform: uppercase;
    color: #121212;
    background: #e5ce9e;
    padding: 0.2rem 0.45rem;
  }

  .luxe-product-card__image-wrap {
    display: block;
    aspect-ratio: 4 / 4.6;
    background: #efefef;
    overflow: hidden;
  }

  .luxe-product-card__image,
  .luxe-product-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .luxe-product-card__placeholder path {
    fill: #c9c9c9;
  }

  .luxe-product-card__content {
    display: grid;
    gap: 0.5rem;
    padding: 0.6rem;
  }

  .luxe-product-card__title {
    font-size: 0.79rem;
    font-weight: 600;
    line-height: 1.22;
  }

  .luxe-product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .luxe-product-card__prices {
    display: flex;
    gap: 0.35rem;
    align-items: center;
    font-size: 0.73rem;
  }

  .luxe-product-card__prices s {
    color: #7a7a7a;
  }

  .luxe-product-card__button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 0.45rem 0.5rem;
    border: 1px solid #242424;
    text-decoration: none;
    color: #151515;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .luxe-product-card__button:hover {
    background-color: #121212;
    color: #f7f7f7;
  }

  .luxe-homepage__textures-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .luxe-texture-card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3.2;
    border: 1px solid color-mix(in srgb, var(--luxe-muted) 40%, transparent);
    overflow: hidden;
    text-decoration: none;
    background: color-mix(in srgb, var(--luxe-surface) 85%, black);
  }

  .luxe-texture-card__image,
  .luxe-texture-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .luxe-texture-card__placeholder path {
    fill: color-mix(in srgb, var(--luxe-muted) 28%, transparent);
  }

  .luxe-texture-card__label {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 0.62rem 0.45rem;
    background: linear-gradient(to top, rgb(0 0 0 / 74%), transparent);
    color: #f8efe0;
    text-align: center;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .luxe-homepage__social-proof {
    margin-top: 2.2rem;
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    text-align: center;
  }

  .luxe-homepage__stars {
    color: #d6b776;
    letter-spacing: 0.25rem;
    font-size: 1rem;
  }

  .luxe-homepage__review-line {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    font-size: 0.88rem;
    color: color-mix(in srgb, var(--luxe-text) 90%, var(--luxe-muted));
  }

  .luxe-homepage__guarantee-line {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.84rem;
    color: var(--luxe-muted);
  }

  @media (max-width: 989px) {
    .luxe-homepage__hero {
      grid-template-columns: 1fr;
    }

    .luxe-homepage__hero-media {
      min-height: 360px;
    }

    .luxe-homepage__hero-image,
    .luxe-homepage__hero-placeholder {
      border-radius: 0.5rem;
    }

    .luxe-homepage__catalog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .luxe-homepage__textures-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .luxe-homepage__container {
      width: calc(100% - 1rem);
    }

    .luxe-homepage__hero-title {
      max-width: 100%;
      font-size: clamp(1.8rem, 11vw, 3rem);
    }

    .luxe-homepage__hero-subtitle {
      font-size: 0.86rem;
    }

    .luxe-homepage__benefits {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.65rem;
    }

    .luxe-homepage__benefit {
      font-size: 0.67rem;
    }

    .luxe-homepage__catalog-grid,
    .luxe-homepage__textures-grid {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .luxe-product-card__title {
      font-size: 0.88rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Luxe homepage",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "textarea",
      "id": "hero_title",
      "label": "Hero title",
      "default": "PREMIUM\nHAIR\nEXTENSIONS"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero subtitle",
      "default": "100% VIRGIN HAIR"
    },
    {
      "type": "text",
      "id": "hero_button_label",
      "label": "Hero button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "hero_button_link",
      "label": "Hero button link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "header",
      "content": "Section headings"
    },
    {
      "type": "text",
      "id": "best_sellers_heading",
      "label": "Best sellers heading",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "textures_heading",
      "label": "Textures heading",
      "default": "Choose Your Textures"
    },
    {
      "type": "text",
      "id": "reviews_heading",
      "label": "Reviews heading",
      "default": "Hundreds of 5-star reviews"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "100% virgin hair guaranteed"
    },
    {
      "type": "header",
      "content": "Benefits bar"
    },
    {
      "type": "text",
      "id": "benefit_text_1",
      "label": "Benefit 1",
      "default": "Free express shipping"
    },
    {
      "type": "text",
      "id": "benefit_text_2",
      "label": "Benefit 2",
      "default": "100% virgin hair"
    },
    {
      "type": "text",
      "id": "benefit_text_3",
      "label": "Benefit 3",
      "default": "Buy now, pay later"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#080808"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Surface color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#f7ecd8"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text color",
      "default": "#d0bb92"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background",
      "default": "#d2b27b"
    },
