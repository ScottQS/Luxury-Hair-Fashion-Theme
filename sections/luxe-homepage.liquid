{% liquid
  assign hero_link = section.settings.hero_button_link
  if hero_link == blank
    assign hero_link = routes.all_products_collection_url
  endif

  assign hero_button_label = section.settings.hero_button_label
  if hero_button_label == blank
    assign hero_button_label = 'SHOP NOW'
  endif

  assign sample_product_assets = 'luxe-product-body-wave.png|luxe-product-curly.png|luxe-product-straight.png|luxe-product-wig.png' | split: '|'
  assign sample_texture_assets = 'luxe-texture-body-wave.jpg|luxe-texture-curly.jpg|luxe-texture-straight.jpg' | split: '|'
%}

<section
  class="luxe-homepage full-width"
  style="
    --luxe-bg: {{ section.settings.background_color }};
    --luxe-surface: {{ section.settings.surface_color }};
    --luxe-text: {{ section.settings.text_color }};
    --luxe-muted: {{ section.settings.muted_text_color }};
    --luxe-button-bg: {{ section.settings.button_background_color }};
    --luxe-button-text: {{ section.settings.button_text_color }};
  "
>
  <div class="luxe-homepage__background">
    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2000
        | image_tag:
          class: 'luxe-homepage__background-image',
          loading: 'lazy',
          sizes: '100vw',
          widths: '1200, 1600, 2000',
          alt: section.settings.background_image.alt
      }}
    {% else %}
      <img
        class="luxe-homepage__background-image"
        src="{{ 'luxe-sample-background.svg' | asset_url }}"
        width="1200"
        height="2400"
        loading="lazy"
        alt=""
      >
    {% endif %}
    <div class="luxe-homepage__background-overlay"></div>
  </div>

  <div class="luxe-homepage__container">
    <div class="luxe-homepage__hero">
      <div class="luxe-homepage__hero-copy">
        <h1 class="luxe-homepage__hero-title">{{ section.settings.hero_title | newline_to_br }}</h1>

        {% if section.settings.hero_subtitle != blank %}
          <p class="luxe-homepage__hero-subtitle">{{ section.settings.hero_subtitle }}</p>
        {% endif %}

        <a class="luxe-homepage__hero-button" href="{{ hero_link }}">{{ hero_button_label }}</a>
      </div>

      <div class="luxe-homepage__hero-media">
        {% if section.settings.hero_image != blank %}
          {{
            section.settings.hero_image
            | image_url: width: 1300
            | image_tag:
              class: 'luxe-homepage__hero-image',
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '(min-width: 520px) 48vw, 49vw',
              widths: '500, 700, 900, 1100, 1300',
              alt: section.settings.hero_image.alt
          }}
        {% else %}
          <img
            class="luxe-homepage__hero-image luxe-homepage__hero-image--sample"
            src="{{ 'luxe-sample-hero.jpg' | asset_url }}"
            width="760"
            height="980"
            loading="eager"
            fetchpriority="high"
            alt="Sample hero image"
          >
        {% endif %}
      </div>
    </div>

    <div class="luxe-homepage__benefits" role="list">
      <div class="luxe-homepage__benefit" role="listitem">
        <span class="luxe-homepage__benefit-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path
              d="M2 12h3l2.5-4 3.5 8 3-6H22"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <span>{{ section.settings.benefit_text_1 }}</span>
      </div>

      <div class="luxe-homepage__benefit" role="listitem">
        <span class="luxe-homepage__benefit-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.4" />
            <path d="m8 12.5 2.5 2.5L16 9.5" fill="none" stroke="currentColor" stroke-width="1.4" />
          </svg>
        </span>
        <span>{{ section.settings.benefit_text_2 }}</span>
      </div>

      <div class="luxe-homepage__benefit" role="listitem">
        <span class="luxe-homepage__benefit-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path
              d="M4 8h16l-1 10H5L4 8Zm2-2h12l1 2H5l1-2Zm4 6v4m4-4v4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <span>{{ section.settings.benefit_text_3 }}</span>
      </div>
    </div>

    <section class="luxe-homepage__catalog">
      <h2 class="luxe-homepage__section-title">{{ section.settings.best_sellers_heading }}</h2>

      <div class="luxe-homepage__catalog-grid">
        {% assign product_blocks = section.blocks | where: 'type', 'product_card' %}
        {% if product_blocks.size > 0 %}
          {% for block in product_blocks %}
            {% liquid
              assign product_ref = block.settings.product
              assign card_link = block.settings.link
              assign card_title = block.settings.title
              assign card_price = block.settings.price_text
              assign card_compare_price = block.settings.compare_price_text

              if product_ref != blank
                assign card_link = product_ref.url
                assign card_title = product_ref.title
                assign card_price = product_ref.price | money
                if product_ref.compare_at_price_max > product_ref.price
                  assign card_compare_price = product_ref.compare_at_price_max | money
                else
                  assign card_compare_price = blank
                endif
              endif

              if card_link == blank
                assign card_link = routes.all_products_collection_url
              endif

              if card_title == blank
                assign card_title = 'Signature Bundle'
              endif

              if card_price == blank
                assign card_price = '$330.00'
              endif

              assign sample_product_index = forloop.index0 | modulo: 4
              assign sample_product_asset = sample_product_assets[sample_product_index]
            %}

            <article class="luxe-product-card" {{ block.shopify_attributes }}>
              {% if block.settings.show_badge %}
                <span class="luxe-product-card__badge">{{ block.settings.badge_text }}</span>
              {% endif %}

              <a class="luxe-product-card__image-wrap" href="{{ card_link }}">
                {% if product_ref != blank and product_ref.featured_image != blank %}
                  {{
                    product_ref.featured_image
                    | image_url: width: 720
                    | image_tag:
                      class: 'luxe-product-card__image',
                      loading: 'lazy',
                      sizes: '(min-width: 520px) 110px, 22vw',
                      widths: '220, 360, 500, 720',
                      alt: card_title
                  }}
                {% elsif block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 720
                    | image_tag:
                      class: 'luxe-product-card__image',
                      loading: 'lazy',
                      sizes: '(min-width: 520px) 110px, 22vw',
                      widths: '220, 360, 500, 720',
                      alt: card_title
                  }}
                {% else %}
                  <img
                    class="luxe-product-card__image luxe-product-card__image--sample"
                    src="{{ sample_product_asset | asset_url }}"
                    width="440"
                    height="520"
                    loading="lazy"
                    alt="{{ card_title | escape }}"
                  >
                {% endif %}
              </a>

              <div class="luxe-product-card__content">
                <h3 class="luxe-product-card__title">
                  <a href="{{ card_link }}">{{ card_title }}</a>
                </h3>

                <p class="luxe-product-card__prices">
                  <span>{{ card_price }}</span>
                  {% if card_compare_price != blank %}
                    <s>{{ card_compare_price }}</s>
                  {% endif %}
                </p>

                <a class="luxe-product-card__button" href="{{ card_link }}">{{ block.settings.button_label }}</a>
              </div>
            </article>
          {% endfor %}
        {% else %}
          {% for item in (1..4) %}
            {% liquid
              assign sample_product_index = forloop.index0 | modulo: 4
              assign sample_product_asset = sample_product_assets[sample_product_index]
            %}

            <article class="luxe-product-card">
              <span class="luxe-product-card__badge">NEW</span>
              <a class="luxe-product-card__image-wrap" href="{{ routes.all_products_collection_url }}">
                <img
                  class="luxe-product-card__image luxe-product-card__image--sample"
                  src="{{ sample_product_asset | asset_url }}"
                  width="440"
                  height="520"
                  loading="lazy"
                  alt="Sample product image {{ item }}"
                >
              </a>
              <div class="luxe-product-card__content">
                <h3 class="luxe-product-card__title">
                  <a href="{{ routes.all_products_collection_url }}">Signature Bundle {{ item }}</a>
                </h3>
                <p class="luxe-product-card__prices"><span>$330.00</span><s>$390.00</s></p>
                <a class="luxe-product-card__button" href="{{ routes.all_products_collection_url }}">SHOP NOW</a>
              </div>
            </article>
          {% endfor %}
        {% endif %}
      </div>
    </section>

    <section class="luxe-homepage__textures">
      <h2 class="luxe-homepage__section-title">{{ section.settings.textures_heading }}</h2>
      <div class="luxe-homepage__textures-grid">
        {% assign texture_blocks = section.blocks | where: 'type', 'texture' %}
        {% if texture_blocks.size > 0 %}
          {% for block in texture_blocks %}
            {% liquid
              assign texture_link = block.settings.link
              if texture_link == blank
                assign texture_link = routes.all_products_collection_url
              endif

              assign sample_texture_index = forloop.index0 | modulo: 3
              assign sample_texture_asset = sample_texture_assets[sample_texture_index]
            %}

            <a class="luxe-texture-card" href="{{ texture_link }}" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    class: 'luxe-texture-card__image',
                    loading: 'lazy',
                    sizes: '(min-width: 520px) 156px, 32vw',
                    widths: '240, 420, 620, 820, 1000',
                    alt: block.settings.label
                }}
              {% else %}
                <img
                  class="luxe-texture-card__image luxe-texture-card__image--sample"
                  src="{{ sample_texture_asset | asset_url }}"
                  width="620"
                  height="420"
                  loading="lazy"
                  alt="{{ block.settings.label | escape }}"
                >
              {% endif %}
              <span class="luxe-texture-card__label">{{ block.settings.label }}</span>
            </a>
          {% endfor %}
        {% else %}
          {% assign texture_names = 'Body Wave,Curly,Straight' | split: ',' %}
          {% for texture_name in texture_names %}
            {% liquid
              assign sample_texture_index = forloop.index0 | modulo: 3
              assign sample_texture_asset = sample_texture_assets[sample_texture_index]
            %}
            <a class="luxe-texture-card" href="{{ routes.all_products_collection_url }}">
              <img
                class="luxe-texture-card__image luxe-texture-card__image--sample"
                src="{{ sample_texture_asset | asset_url }}"
                width="620"
                height="420"
                loading="lazy"
                alt="Sample {{ texture_name }} texture image"
              >
              <span class="luxe-texture-card__label">{{ texture_name }}</span>
            </a>
          {% endfor %}
        {% endif %}
      </div>
    </section>

    <section class="luxe-homepage__social-proof">
      <p class="luxe-homepage__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
      <p class="luxe-homepage__review-line">{{ section.settings.reviews_heading }}</p>
      <p class="luxe-homepage__guarantee-line">{{ section.settings.guarantee_text }}</p>
    </section>
  </div>
</section>

{% stylesheet %}
  .luxe-homepage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--luxe-bg);
    color: var(--luxe-text);
  }

  .luxe-homepage__background {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
  }

  .luxe-homepage__background-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.38;
  }

  .luxe-homepage__background-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 16%, rgb(196 156 92 / 19%), transparent 45%),
      radial-gradient(circle at 50% 78%, rgb(196 156 92 / 12%), transparent 40%),
      linear-gradient(180deg, rgb(6 6 7 / 84%), rgb(4 4 4 / 95%));
  }

  .luxe-homepage__container {
    width: min(478px, calc(100% - 0.45rem));
    margin-inline: auto;
    border-left: 1px solid rgb(218 191 142 / 32%);
    border-right: 1px solid rgb(218 191 142 / 32%);
  }

  .luxe-homepage__hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.36rem;
    align-items: end;
    padding: 0.68rem 0.52rem 0;
    border-bottom: 1px solid rgb(218 191 142 / 28%);
  }

  .luxe-homepage__hero-copy {
    padding: 0.08rem 0 0.78rem;
  }

  .luxe-homepage__hero-title {
    font-family: 'Times New Roman', serif;
    font-size: clamp(1.72rem, 9.8vw, 3.2rem);
    line-height: 0.88;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    max-width: 7.5ch;
    text-shadow: 0 1px 10px rgb(0 0 0 / 35%);
  }

  .luxe-homepage__hero-subtitle {
    margin-top: 0.5rem;
    font-size: clamp(0.6rem, 2.6vw, 0.88rem);
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--luxe-muted);
  }

  .luxe-homepage__hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.72rem;
    padding: 0.55rem 1rem;
    min-width: 6.4rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--luxe-button-text);
    background-color: var(--luxe-button-bg);
    border-radius: 0.08rem;
  }

  .luxe-homepage__hero-media {
    display: flex;
    align-items: end;
    justify-content: flex-end;
    min-height: clamp(228px, 63vw, 382px);
  }

  .luxe-homepage__hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 16%;
  }

  .luxe-homepage__hero-image--sample {
    filter: saturate(0.82) brightness(0.8) contrast(1.03);
  }

  .luxe-homepage__benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.24rem;
    align-items: center;
    border-bottom: 1px solid rgb(218 191 142 / 26%);
    padding: 0.54rem 0.3rem;
  }

  .luxe-homepage__benefit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.34rem;
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
    text-align: center;
    color: #e6d6b6;
  }

  .luxe-homepage__benefit-icon {
    display: inline-flex;
    width: 0.9rem;
    height: 0.9rem;
    color: var(--luxe-muted);
    flex: 0 0 auto;
  }

  .luxe-homepage__benefit-icon svg {
    width: 100%;
    height: 100%;
  }

  .luxe-homepage__catalog {
    padding: 0.9rem 0.42rem 0;
  }

  .luxe-homepage__section-title {
    margin: 0 0 0.72rem;
    text-align: center;
    font-family: 'Times New Roman', serif;
    font-size: clamp(1.48rem, 7.3vw, 2.25rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #e7d1a5;
    text-shadow: 0 1px 8px rgb(0 0 0 / 34%);
  }

  .luxe-homepage__catalog-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.34rem;
  }

  .luxe-product-card {
    position: relative;
    background: #f8f5ef;
    color: #151515;
    border: 1px solid #d8c8ad;
    overflow: hidden;
  }

  .luxe-product-card__badge {
    position: absolute;
    top: 0.22rem;
    left: 0.22rem;
    z-index: 2;
    font-size: 0.44rem;
    letter-spacing: 0.06em;
    font-weight: 700;
    text-transform: uppercase;
    color: #1b1b1b;
    background: #e2c692;
    padding: 0.1rem 0.26rem;
  }

  .luxe-product-card__image-wrap {
    display: block;
    aspect-ratio: 1 / 1.2;
    background: #fdfbf7;
  }

  .luxe-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center 52%;
    padding: 0.16rem;
  }

  .luxe-product-card__image--sample {
    padding: 0.1rem;
  }

  .luxe-product-card__content {
    display: grid;
    gap: 0.16rem;
    padding: 0.28rem;
  }

  .luxe-product-card__title {
    font-size: 0.51rem;
    line-height: 1.2;
    font-weight: 700;
  }

  .luxe-product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .luxe-product-card__prices {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.18rem;
    font-size: 0.5rem;
    line-height: 1.2;
  }

  .luxe-product-card__prices s {
    color: #777;
  }

  .luxe-product-card__button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 0.22rem 0.18rem;
    border: 1px solid #1e1e1e;
    text-decoration: none;
    color: #171717;
    font-size: 0.45rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    background-color: #e6cd9f;
  }

  .luxe-homepage__textures {
    padding: 1.02rem 0.42rem 0;
  }

  .luxe-homepage__textures-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.3rem;
  }

  .luxe-texture-card {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1.01;
    border: 1px solid rgb(218 191 142 / 36%);
    overflow: hidden;
    text-decoration: none;
    background: #0f0f10;
  }

  .luxe-texture-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .luxe-texture-card__image--sample {
    filter: saturate(0.56) brightness(0.62) contrast(1.08);
  }

  .luxe-texture-card__label {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 0.34rem 0.2rem;
    background: linear-gradient(to top, rgb(0 0 0 / 80%), transparent);
    color: #f7e9d1;
    text-align: center;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .luxe-homepage__social-proof {
    margin-top: 1.02rem;
    padding-bottom: 1.1rem;
    display: grid;
    justify-items: center;
    gap: 0.28rem;
    text-align: center;
  }

  .luxe-homepage__stars {
    color: #d2ae70;
    letter-spacing: 0.12rem;
    font-size: 0.84rem;
  }

  .luxe-homepage__review-line {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.68rem;
    font-weight: 700;
    color: #e8dcc7;
  }

  .luxe-homepage__guarantee-line {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.64rem;
    color: var(--luxe-muted);
  }

  @media (min-width: 390px) {
    .luxe-homepage__benefit {
      font-size: 0.57rem;
    }

    .luxe-product-card__title {
      font-size: 0.56rem;
    }

    .luxe-product-card__prices {
      font-size: 0.54rem;
    }

    .luxe-product-card__button {
      font-size: 0.49rem;
    }
  }

  @media (min-width: 520px) {
    .luxe-homepage__container {
      width: 478px;
    }

    .luxe-homepage__hero-copy {
      padding-bottom: 1rem;
    }

    .luxe-homepage__hero-title {
      font-size: 3.18rem;
    }

    .luxe-homepage__hero-subtitle {
      font-size: 0.8rem;
    }

    .luxe-homepage__hero-button {
      font-size: 0.69rem;
      padding: 0.58rem 1.02rem;
    }

    .luxe-homepage__benefit {
      font-size: 0.58rem;
    }

    .luxe-homepage__section-title {
      font-size: 2.32rem;
    }

    .luxe-product-card__title {
      font-size: 0.58rem;
    }

    .luxe-product-card__prices {
      font-size: 0.55rem;
    }

    .luxe-product-card__button {
      font-size: 0.49rem;
      padding: 0.24rem 0.18rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Luxe homepage",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "textarea",
      "id": "hero_title",
      "label": "Hero title",
      "default": "PREMIUM\nHAIR\nEXTENSIONS"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero subtitle",
      "default": "100% VIRGIN HAIR"
    },
    {
      "type": "text",
      "id": "hero_button_label",
      "label": "Hero button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "hero_button_link",
      "label": "Hero button link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "header",
      "content": "Section headings"
    },
    {
      "type": "text",
      "id": "best_sellers_heading",
      "label": "Best sellers heading",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "textures_heading",
      "label": "Textures heading",
      "default": "Choose Your Textures"
    },
    {
      "type": "text",
      "id": "reviews_heading",
      "label": "Reviews heading",
      "default": "Hundreds of 5-star reviews"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "100% virgin hair guaranteed"
    },
    {
      "type": "header",
      "content": "Benefits bar"
    },
    {
      "type": "text",
      "id": "benefit_text_1",
      "label": "Benefit 1",
      "default": "Free express shipping"
    },
    {
      "type": "text",
      "id": "benefit_text_2",
      "label": "Benefit 2",
      "default": "100% virgin hair"
    },
    {
