{% liquid
  assign brand_name = section.settings.brand_name
  if brand_name == blank
    assign brand_name = shop.name
  endif
%}

<header class="luxe-header full-width">
  {% if section.settings.announcement_text != blank %}
    <p class="luxe-header__announcement">{{ section.settings.announcement_text }}</p>
  {% endif %}

  <div class="luxe-header__nav-shell">
    <div class="luxe-header__nav">
      <nav class="luxe-header__menu" aria-label="Primary">
        {% if section.settings.menu != blank %}
          {% for link in section.settings.menu.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          <a href="{{ routes.all_products_collection_url }}">Shop</a>
          <a href="/pages/contact">Contact</a>
        {% endif %}
      </nav>

      <p class="luxe-header__brand">
        <a href="{{ routes.root_url }}">{{ brand_name }}</a>
      </p>

      <div class="luxe-header__actions">
        <a class="luxe-header__icon-link" href="{{ routes.search_url }}" aria-label="Search">
          <svg viewBox="0 0 20 20" fill="none" focusable="false">
            <circle cx="8.8" cy="8.8" r="4.8" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="m12.6 12.6 3.4 3.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
        </a>

        {% if shop.customer_accounts_enabled %}
          <a class="luxe-header__icon-link" href="{{ routes.account_url }}" aria-label="Account">
            {{ 'icon-account.svg' | inline_asset_content }}
          </a>
        {% endif %}

        <a class="luxe-header__icon-link luxe-header__cart-link" href="{{ routes.cart_url }}" aria-label="Cart">
          {{ 'icon-cart.svg' | inline_asset_content }}
          {% if cart.item_count > 0 %}
            <span class="luxe-header__cart-count">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      </div>
    </div>
  </div>
</header>

{% stylesheet %}
  .luxe-header {
    --icon-stroke-width: 1.4;
    background-color: #080808;
    color: #f7ecd8;
    border-bottom: 1px solid rgb(255 255 255 / 9%);
  }

  .luxe-header a {
    color: inherit;
    text-decoration: none;
  }

  .luxe-header__announcement {
    text-align: center;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #d0bb92;
    padding: 0.62rem 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 9%);
  }

  .luxe-header__nav-shell {
    width: min(1200px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .luxe-header__nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 4.2rem;
    gap: 0.6rem;
  }

  .luxe-header__menu,
  .luxe-header__actions {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .luxe-header__menu {
    justify-self: start;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, #f7ecd8 80%, #d0bb92);
  }

  .luxe-header__brand {
    justify-self: center;
    font-family: 'Times New Roman', serif;
    letter-spacing: 0.1em;
    font-size: clamp(1.2rem, 2.2vw, 2rem);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .luxe-header__actions {
    justify-self: end;
  }

  .luxe-header__icon-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.3rem;
    height: 1.3rem;
    color: #f7ecd8;
  }

  .luxe-header__icon-link svg {
    width: 100%;
    height: 100%;
  }

  .luxe-header__cart-count {
    position: absolute;
    top: -0.35rem;
    right: -0.4rem;
    min-width: 1rem;
    padding-inline: 0.22rem;
    border-radius: 999px;
    background-color: #d2b27b;
    color: #131313;
    font-size: 0.62rem;
    font-weight: 700;
    text-align: center;
    line-height: 1rem;
  }

  @media (max-width: 749px) {
    .luxe-header__announcement {
      font-size: 0.6rem;
      letter-spacing: 0.09em;
    }

    .luxe-header__nav-shell {
      width: calc(100% - 1rem);
    }

    .luxe-header__nav {
      grid-template-columns: auto 1fr auto;
      min-height: 3.8rem;
    }

    .luxe-header__menu {
      gap: 0.55rem;
      font-size: 0.68rem;
    }

    .luxe-header__brand {
      font-size: clamp(1rem, 6vw, 1.4rem);
      text-align: center;
    }

    .luxe-header__actions {
      gap: 0.7rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "FREE EXPRESS SHIPPING ON ALL ORDERS $200+"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "LUXE HAIR"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}
