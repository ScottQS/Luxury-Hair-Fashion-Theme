{% liquid
  assign instagram_link = section.settings.instagram_url
  if instagram_link == blank
    assign instagram_link = 'https://instagram.com'
  endif

  assign facebook_link = section.settings.facebook_url
  if facebook_link == blank
    assign facebook_link = 'https://facebook.com'
  endif

  assign twitter_link = section.settings.twitter_url
  if twitter_link == blank
    assign twitter_link = 'https://x.com'
  endif
%}

<footer class="luxe-footer full-width">
  <div class="luxe-footer__container">
    <div class="luxe-footer__row">
      <div class="luxe-footer__socials" aria-label="Social links">
        <a href="{{ instagram_link }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" focusable="false">
            <rect x="4.2" y="4.2" width="15.6" height="15.6" rx="4.6" stroke="currentColor" stroke-width="1.5"></rect>
            <circle cx="12" cy="12" r="3.6" stroke="currentColor" stroke-width="1.5"></circle>
            <circle cx="17.3" cy="6.8" r="1.1" fill="currentColor"></circle>
          </svg>
        </a>
        <a href="{{ facebook_link }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="none" focusable="false">
            <path
              d="M13.5 20v-7.1h2.4l.4-2.9h-2.8V8.2c0-.9.2-1.5 1.5-1.5h1.5V4.1c-.7-.1-1.4-.1-2.1-.1-2 0-3.5 1.2-3.5 3.6V10H8.6v2.9h2.3V20h2.6Z"
              fill="currentColor"
            ></path>
          </svg>
        </a>
        <a href="{{ twitter_link }}" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
          <svg viewBox="0 0 24 24" fill="none" focusable="false">
            <path d="m5 5 14 14m0-14L5 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </a>
      </div>

      {% if section.settings.menu != blank %}
        <nav class="luxe-footer__links" aria-label="Footer links">
          {% for link in section.settings.menu.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        </nav>
      {% endif %}

      {% if section.settings.show_payment_icons %}
        <div class="luxe-footer__payments">
          {% for type in shop.enabled_payment_types %}
            <span class="luxe-footer__payment-icon">{{ type | payment_type_svg_tag }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <p class="luxe-footer__legal">{{ section.settings.legal_text }}</p>
  </div>
</footer>

{% stylesheet %}
  .luxe-footer {
    margin-top: 0;
    background-color: #070707;
    color: #e9dbc2;
    border-top: 1px solid rgb(218 191 142 / 24%);
  }

  .luxe-footer a {
    color: inherit;
    text-decoration: none;
  }

  .luxe-footer__container {
    width: min(478px, calc(100% - 0.45rem));
    margin-inline: auto;
    border-left: 1px solid rgb(218 191 142 / 32%);
    border-right: 1px solid rgb(218 191 142 / 32%);
    padding: 0.58rem 0.48rem 0.68rem;
    display: grid;
    gap: 0.44rem;
  }

  .luxe-footer__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.5rem;
  }

  .luxe-footer__socials,
  .luxe-footer__links,
  .luxe-footer__payments {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .luxe-footer__socials a {
    width: 0.92rem;
    height: 0.92rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.9;
  }

  .luxe-footer__socials svg {
    width: 100%;
    height: 100%;
  }

  .luxe-footer__links {
    justify-self: center;
    font-size: 0.55rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #cab38a;
    flex-wrap: wrap;
    justify-content: center;
  }

  .luxe-footer__payments {
    justify-self: end;
  }

  .luxe-footer__payment-icon svg {
    width: 1.5rem;
    height: auto;
    opacity: 0.75;
  }

  .luxe-footer__legal {
    text-align: center;
    font-size: 0.52rem;
    letter-spacing: 0.06em;
    color: #b49d72;
  }

  @media (max-width: 420px) {
    .luxe-footer__row {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 0.45rem;
    }

    .luxe-footer__payments {
      justify-self: center;
      flex-wrap: wrap;
      justify-content: center;
    }
  }

  @media (min-width: 520px) {
    .luxe-footer__container {
      width: 478px;
    }

    .luxe-footer__socials a {
      width: 1rem;
      height: 1rem;
    }

    .luxe-footer__links {
      font-size: 0.61rem;
    }

    .luxe-footer__legal {
      font-size: 0.57rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X/Twitter URL"
    },
    {
      "type": "text",
      "id": "legal_text",
      "label": "Legal text",
      "default": "Copyright 2026 Luxe Hair. All rights reserved."
    }
  ]
}
{% endschema %}
